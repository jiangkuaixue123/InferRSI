+                )
+            with tempfile.TemporaryDirectory(prefix="inferrsi-intake-") as tmp:
+                staged_args = copy.copy(args)
+                staged_args.session = Path(tmp) / "campaign"
+                frozen = run_session(staged_args, initialize=lambda _, plan: {"plan": plan})
+                plan = frozen["plan"]
