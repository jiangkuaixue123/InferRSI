+    record["fields"]["bogus.path"] = {"value": 1, "source": "prompt", "status": "confirmed"}
+    with pytest.raises(intake.IntakeError) as error:
+        intake.evaluate(record, spec)
+    assert error.value.code == "invalid_record"
