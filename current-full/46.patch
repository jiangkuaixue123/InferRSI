+    record.write_text(json.dumps(build(set(PARTIAL["fields"]["values"]))), encoding="utf-8")
+    assert cli.main(start_arguments(project, extra=("--intake", str(record)))) == 2
+    gate = json.loads(capsys.readouterr().out)
