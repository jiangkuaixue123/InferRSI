+    assert not campaign["root"].exists()
+    campaign["config"].write_text(json.dumps(original))
+    assert main(args) == 0
+    plan = service_io.read(campaign["root"] / "plan.json")
+    assert (campaign["root"] / plan["intake_receipt"]).is_file()
