+                         ensure_ascii=False, indent=2))
+        return 2
+    if getattr(args, "json", False):
+        print(json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False))
+    else:
+        print(render_summary(result) if args.intake_action == "summary" else render(result))
+    return 0
